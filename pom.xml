<?xml version="1.0" encoding="UTF-8"?>
<!--
  Azure Key Vault Configuration Property Provider (Mule 4 extension).
  WP1 skeleton. Versions are pinned to what Maven Central currently publishes.
  UNVERIFIED (plan FINAL gates): the parent's mule.version is 4.1.1, not the 4.9 target.
  See the properties block below and the WP1 notes in README.md.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.mule.extensions</groupId>
    <artifactId>mule-modules-parent</artifactId>
    <version>1.1.3</version>
  </parent>

  <groupId>com.kepak.mule</groupId>
  <artifactId>azure-keyvault-config-provider</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>mule-extension</packaging>
  <name>Azure Key Vault Configuration Property Provider</name>

  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <maven.compiler.release>17</maven.compiler.release>
    <!-- Target runtime is Mule 4.9+ (plan Q4). The parent currently pins 4.1.1; override and verify in WP7. -->
    <mule.version>4.9.0</mule.version>
    <azure.sdk.bom.version>1.3.8</azure.sdk.bom.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>com.azure</groupId>
        <artifactId>azure-sdk-bom</artifactId>
        <version>${azure.sdk.bom.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <!-- Mule SDK extension API. Provided by the runtime. Coordinates per parent; confirm for 4.9 (plan 2.4). -->
    <dependency>
      <groupId>org.mule.runtime</groupId>
      <artifactId>mule-extensions-api</artifactId>
      <version>${mule.sdk.version}</version>
      <scope>provided</scope>
    </dependency>

    <dependency>
      <groupId>com.azure</groupId>
      <artifactId>azure-identity</artifactId>
    </dependency>
    <dependency>
      <groupId>com.azure</groupId>
      <artifactId>azure-security-keyvault-secrets</artifactId>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.mule.tools.maven</groupId>
        <artifactId>mule-maven-plugin</artifactId>
        <version>2.1</version>
        <extensions>true</extensions>
      </plugin>
    </plugins>
  </build>
</project>
